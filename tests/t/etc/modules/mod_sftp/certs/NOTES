-------------------------------------
Host CAs, Certificates
-------------------------------------
To create the RSA host CA key files:

  $ ssh-keygen -t rsa -C "ProFTPD mod_sftp Testing RSA Host CA Key" -f authorized_host_rsa_ca_key

  # After this, manually edit the generated text to replace the OpenSSH
  # Comment with the above -C text.
  $ ssh-keygen -e -f ./authorized_host_rsa_ca_key.pub > authorized_host_rsa_ca_keys

To sign the RSA host certificates:

  $ ssh-keygen -s authorized_host_rsa_ca_key -I "mod_sftp test RSA cert" -h -n 127.0.0.1 -V +30d -z 101 ../test_rsa_key.pub
  $ mv ../test_rsa_key-cert.pub ./host_rsa_ca_rsa_cert.pub

  # For use for AllowMatchPrincipals integration tests
  $ ssh-keygen -s authorized_host_rsa_ca_key -I "mod_sftp test RSA cert with AllowMatchPrincipals" -h -n '127.?.?.*,l?calh*' -V +30d -z 106 ../test_rsa_key.pub
  $ mv ../test_rsa_key-cert.pub ./host_rsa_ca_rsa_cert_match_principals.pub

  # For use for AllowEmptyPrincipals integration tests
  $ ssh-keygen -s authorized_host_rsa_ca_key -I "mod_sftp test RSA cert with AllowEmptyPrincipals" -h -V +30d -z 107 ../test_rsa_key.pub
  $ mv ../test_rsa_key-cert.pub ./host_rsa_ca_rsa_cert_empty_principals.pub

  $ ssh-keygen -s authorized_host_rsa_ca_key -I "mod_sftp test ECDSA256 cert" -h -n 127.0.0.1 -V +30d -z 102 ../test_ecdsa256_key.pub
  $ mv ../test_ecdsa256_key-cert.pub ./host_rsa_ca_ecdsa256_cert.pub

  $ ssh-keygen -s authorized_host_rsa_ca_key -I "mod_sftp test ECDSA384 cert" -h -n 127.0.0.1 -V +30d -z 103 ../test_ecdsa384_key.pub
  $ mv ../test_ecdsa384_key-cert.pub ./host_rsa_ca_ecdsa384_cert.pub

  $ ssh-keygen -s authorized_host_rsa_ca_key -I "mod_sftp test ECDSA521 cert" -h -n 127.0.0.1 -V +30d -z 104 ../test_ecdsa521_key.pub
  $ mv ../test_ecdsa521_key-cert.pub ./host_rsa_ca_ecdsa521_cert.pub

  $ ssh-keygen -s authorized_host_rsa_ca_key -I "mod_sftp test ED25519 cert" -h -n 127.0.0.1 -V +30d -z 105 ../test_openssh_ed25519_key.pub
  $ mv ../test_openssh_ed25519_key-cert.pub ./host_rsa_ca_ed25519_cert.pub

